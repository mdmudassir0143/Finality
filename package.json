{
  "name": "finality-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "bash scripts/run-finality.sh",
    "dev:frontend": "bash scripts/run-frontend.sh",
    "dev:merchant": "bash scripts/run-merchant.sh",
    "dev:x402": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env x402-server/index.ts",
    "dev:facilitator": "tsx --env-file-if-exists=.env facilitator/index.ts",
    "build": "next build --webpack",
    "build:x402": "tsc -p x402-server/tsconfig.json",
    "start": "next start",
    "start:x402": "node x402-server/dist/x402-server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:x402": "vitest run x402-server/tests",
    "test:x402:testnet": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env scripts/testnet-paid-smoke.ts",
    "test:x402:evm": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env scripts/evm-paid-smoke.ts",
    "associate:test-usdc": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env scripts/associate-test-usdc.ts",
    "erc8004:register": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env scripts/erc8004-register.ts",
    "agent": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env agent/cli.ts",
    "agents": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env agents/cli.ts",
    "hcs:allow-agent": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env scripts/hcs-allow-agent.ts",
    "test:wallet:e2e": "tsx --env-file-if-exists=.env scripts/e2e-wallet.ts",
    "hcs:create-audit-topic": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env scripts/create-audit-topic.ts",
    "check:discovery": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env scripts/check-discovery.ts",
    "fusd:compile": "tsx contracts/compile.ts",
    "fusd:deploy": "tsx --env-file-if-exists=.env --env-file-if-exists=x402-server/.env scripts/deploy-fusd.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.112",
    "@hashgraph/hedera-agent-kit": "^4.2.0",
    "@hashgraph/hedera-agent-kit-ai-sdk": "^2.1.0",
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hashgraphonline/standards-sdk": "^0.1.192",
    "@hiero-ledger/sdk": "^2.90.1",
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@reown/appkit": "1.8.24",
    "@walletconnect/modal": "^2.7.0",
    "@x402/core": "^2.30.0",
    "@x402/evm": "^2.30.0",
    "@x402/fetch": "^2.30.0",
    "@x402/hedera": "^2.30.0",
    "@x402/hono": "^2.30.0",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "dotted-map": "^3.1.0",
    "framer-motion": "^13.4.1",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "magic-sdk": "^33.13.0",
    "next": "^16.3.5",
    "openai": "^4.77.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swagger-ui-react": "^5.33.0",
    "tailwind-merge": "^3.7.0",
    "viem": "2.57.16",
    "zod": "^3.25.76",
    "zod4": "npm:zod@^4.6.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.4.49",
    "solc": "^0.8.28",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@hashgraph/hedera-wallet-connect": {
      "@hiero-ledger/sdk": "2.90.1"
    }
  }
}
