{
  "name": "finality-x402-keeper",
  "version": "1.0.0",
  "private": true,
  "description": "Keeper that funds Hedera testnet wallets (default 15; set WALLET_COUNT=50 for full fleet) and randomly hits Finality x402 paid routes",
  "type": "module",
  "scripts": {
    "funders": "tsx src/cli.ts funders",
    "funders-associate": "tsx --env-file=.env src/cli.ts funders-associate",
    "wallets": "tsx --env-file=.env src/cli.ts wallets",
    "fund": "tsx --env-file=.env src/cli.ts fund",
    "associate": "tsx --env-file=.env src/cli.ts associate",
    "run": "tsx --env-file=.env src/cli.ts run",
    "health": "tsx --env-file=.env src/cli.ts health",
    "start": "tsx src/cli.ts run",
    "setup": "tsx --env-file=.env src/cli.ts setup",
    "status": "tsx --env-file=.env src/cli.ts status",
    "pack-wallets": "tsx scripts/pack-wallets-for-render.ts",
    "help": "tsx src/cli.ts help"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.90.1",
    "@x402/core": "2.30.0",
    "@x402/fetch": "2.30.0",
    "@x402/hedera": "2.30.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.7.2"
  }
}
