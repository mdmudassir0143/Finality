# Hedera network (testnet default)
X402_NETWORK=hedera-testnet
USDC_TOKEN_ID=0.0.429274
HBAR_ASSET=0.0.0
USDC_DECIMALS=6
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
FACILITATOR=https://api.testnet.blocky402.com

# Finality x402 merchant base URL (no trailing slash)
X402_BASE_URL=https://finality-x402-backend.onrender.com

# Optional operator — used by `npm run funders` to AccountCreateTransaction new funders
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=

# Funding amounts
HBAR_DRIP_AMOUNT=5
USDC_DROP_AMOUNT=5
# Default 15 for testing; set to 50 for the full keeper fleet
WALLET_COUNT=15

# Five funder wallets — generated by: npm run funders
# Private keys: DER or hex (ECDSA preferred). Also stored in data/funders.json
FUNDER_1_ACCOUNT_ID=
FUNDER_1_PRIVATE_KEY=
FUNDER_2_ACCOUNT_ID=
FUNDER_2_PRIVATE_KEY=
FUNDER_3_ACCOUNT_ID=
FUNDER_3_PRIVATE_KEY=
FUNDER_4_ACCOUNT_ID=
FUNDER_4_PRIVATE_KEY=
FUNDER_5_ACCOUNT_ID=
FUNDER_5_PRIVATE_KEY=

# Random loop timing between paid calls (milliseconds).
# Bootstrap only — UI Timing dropdown overrides at runtime (POST /api/delay).
# Presets: 30s-2m | 30s-3m | 1m-5m | 30s-1.5m
MIN_DELAY_MS=30000
MAX_DELAY_MS=120000

# Optional: stop after N paid calls (omit or 0 = run forever)
MAX_CALLS=0

# Keeper UI / health HTTP (GET /, /healthz, /health, /logs, POST /api/filter|delay|start|stop)
HEALTH_PORT=4090
# Optional bearer token for Start/Stop when exposed publicly
KEEPER_CONTROL_TOKEN=
# Auto-start traffic loop on `npm run run` (UI can still stop/start)
LOOP_AUTOSTART=true
# Optional bootstrap filter (UI dropdown overrides at runtime without editing env).
# Values: onchain | pro | onchain,pro
ENDPOINT_FILTER=onchain,pro
# Render seed: base64 of data/wallets.json (npm run pack-wallets)
KEEPER_WALLETS_JSON=
