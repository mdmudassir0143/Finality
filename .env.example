# Copy to .env (single source for the merchant, scripts and Next.js); never commit real secrets.
# Optional: x402-server/.env overrides merchant values.
X402_PAYTO_ADDRESS=0.0.0
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera-testnet
X402_USDC_TOKEN_ID=0.0.429274
X402_USD_PER_HBAR=0.2
X402_ALLOWED_ORIGINS=https://finality.accuracy.wtf,http://localhost:3000
X402_SERVER_PORT=4021
X402_PUBLIC_URL=https://finality-x402-backend.onrender.com
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# HCS audit trail (optional; off unless all three are set). Create the topic with: npm run hcs:create-audit-topic
HCS_AUDIT_TOPIC_ID=
MERCHANT_OPERATOR_ID=
MERCHANT_OPERATOR_KEY=
# ERC-8004 identities on Hedera EVM (canonical registries on Hedera testnet are the defaults).
# Register with: npm run erc8004:register -- merchant   /   npm run erc8004:register -- agent
ERC8004_MERCHANT_AGENT_ID=
ERC8004_AGENT_ID=
# EVM_RPC_URL=https://testnet.hashio.io/api
# ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Step 14b: Finality's own x402 facilitator for Hedera EVM (fUSD, EIP-3009). Additive; Blocky402 is unchanged.
# Dedicated ECDSA gas wallet funded with HBAR (never the merchant/operator key). npm run dev:facilitator
FACILITATOR_EVM_KEY=
FACILITATOR_PORT=4022
# Merchant EVM payee for fUSD (the treasury account's EVM alias); the facilitator only pays gas for this payee.
X402_EVM_PAYTO_ADDRESS=
# Merchant: setting this adds a third 402 accept (fUSD on eip155:296) routed to the facilitator above.
X402_EVM_FACILITATOR_URL=
# Optional: fUSD address override (default contracts/deployments/<network>.json)
# FUSD_ADDRESS=
DATA_MODE=auto
ALLOW_MOCK_FALLBACK=true
ENABLE_DUMMY_ENDPOINT=false
# Optional CoinGecko Demo key (public endpoints work without it)
COINGECKO_API_KEY=
# Optional CoinGecko Pro key for onchain token_price / coins/list
COINGECKO_PRO_API_KEY=
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3:8b
GROQ_API_KEY=
GROQ_MODEL=
# Google AI Studio key — set on the x402 merchant (.env or Render backend env), NOT the keeper.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NEXTAUTH_URL=https://finality.accuracy.wtf
NEXT_PUBLIC_APP_URL=https://finality.accuracy.wtf
NEXT_PUBLIC_X402_API_URL=https://finality-x402-backend.onrender.com
NEXT_PUBLIC_X402_SERVER_URL=https://finality-x402-backend.onrender.com
NEXT_PUBLIC_HEDERA_NETWORK=hedera-testnet
NEXT_PUBLIC_USDC_TOKEN_ID=0.0.429274
NEXT_PUBLIC_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Magic email wallet (Connect wallet → Email). Publishable key is browser-safe; the secret key is server-only.
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=
MAGIC_SECRET_KEY=
X402_SERVER_URL=https://finality-x402-backend.onrender.com

# Test-only payer credentials belong in .env, never this template.
X402_TEST_PAYER_ACCOUNT_ID=
X402_TEST_PAYER_PRIVATE_KEY=
# Optional smoke overrides (npm run test:x402:testnet):
# X402_SMOKE_BASE_URL=http://localhost:4021
# X402_SMOKE_PATH=/v1/onchain/hedera/network/supply
# X402_SMOKE_ASSETS=USDC,HBAR
